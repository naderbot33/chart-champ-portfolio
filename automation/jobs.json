{
  "version": 1,
  "timezone": "America/Los_Angeles",
  "defaults": {
    "status": "PAUSED",
    "kind": "cron",
    "executionEnvironment": "local",
    "deliveryMode": "dry-run",
    "draftFreshnessMinutes": 15,
    "sidekickMinimumRemainingAfterRun": 10
  },
  "jobs": [
    {
      "id": "trending-tickers-open",
      "name": "ChartChamp Trending Tickers - Open",
      "channel": "trending-tickers",
      "rrule": "FREQ=WEEKLY;BYDAY=MO,TU,WE,TH,FR;BYHOUR=6;BYMINUTE=45",
      "promptFile": "prompts/trending-tickers-open.md",
      "model": "gpt-5.6-terra",
      "reasoningEffort": "medium",
      "validation": {
        "freshnessMinutes": 30,
        "marketDependent": true,
        "requiredSites": ["yahoo"],
        "sourceMaximums": {"itemCount": 4},
        "requiredSourceFlags": ["catalystsVerified"]
      }
    },
    {
      "id": "trending-tickers-close",
      "name": "ChartChamp Trending Tickers - Close",
      "channel": "trending-tickers",
      "rrule": "FREQ=WEEKLY;BYDAY=MO,TU,WE,TH,FR;BYHOUR=13;BYMINUTE=15",
      "promptFile": "prompts/trending-tickers-close.md",
      "model": "gpt-5.6-terra",
      "reasoningEffort": "medium",
      "validation": {
        "freshnessMinutes": 30,
        "marketDependent": true,
        "requiredSites": ["yahoo"],
        "sourceMaximums": {"itemCount": 4},
        "requiredSourceFlags": ["catalystsVerified"]
      }
    },
    {
      "id": "market-briefs-daily",
      "name": "ChartChamp Global Market Brief",
      "channel": "market-briefs",
      "rrule": "FREQ=WEEKLY;BYDAY=MO,TU,WE,TH,FR;BYHOUR=7;BYMINUTE=0",
      "promptFile": "prompts/market-briefs-daily.md",
      "model": "gpt-5.6-terra",
      "reasoningEffort": "high",
      "validation": {
        "freshnessMinutes": 90,
        "marketDependent": true,
        "allowClosedMarketWhenMaterial": true,
        "requiredSites": ["trendspider"],
        "requiresSidekick": true,
        "estimatedSidekickMessages": 1,
        "sourceMaximums": {"itemCount": 6},
        "requiredSourceFlags": ["materialItemsOnly"]
      }
    },
    {
      "id": "market-scanners-open",
      "name": "ChartChamp Market Scanners - Open",
      "channel": "market-scanners",
      "rrule": "FREQ=WEEKLY;BYDAY=MO,TU,WE,TH,FR;BYHOUR=7;BYMINUTE=20",
      "promptFile": "prompts/market-scanners-open.md",
      "model": "gpt-5.6-terra",
      "reasoningEffort": "high",
      "validation": {
        "freshnessMinutes": 30,
        "marketDependent": true,
        "requiredSites": ["trendspider"],
        "requiresSidekick": true,
        "estimatedSidekickMessages": 1,
        "requiresScannerSafety": true,
        "sourceMaximums": {"itemCount": 5},
        "requiredSourceFlags": ["actualScannerResults"]
      }
    },
    {
      "id": "market-scanners-close",
      "name": "ChartChamp Market Scanners - Close",
      "channel": "market-scanners",
      "rrule": "FREQ=WEEKLY;BYDAY=MO,TU,WE,TH,FR;BYHOUR=13;BYMINUTE=30",
      "promptFile": "prompts/market-scanners-close.md",
      "model": "gpt-5.6-terra",
      "reasoningEffort": "high",
      "validation": {
        "freshnessMinutes": 30,
        "marketDependent": true,
        "requiredSites": ["trendspider"],
        "requiresSidekick": true,
        "estimatedSidekickMessages": 1,
        "requiresScannerSafety": true,
        "sourceMaximums": {"itemCount": 5},
        "requiredSourceFlags": ["actualScannerResults"]
      }
    },
    {
      "id": "economic-data-mwf",
      "name": "ChartChamp Economic Data - MWF",
      "channel": "economic-data",
      "rrule": "FREQ=WEEKLY;BYDAY=MO,WE,FR;BYHOUR=7;BYMINUTE=40",
      "promptFile": "prompts/economic-data-mwf.md",
      "model": "gpt-5.6-terra",
      "reasoningEffort": "high",
      "validation": {
        "freshnessMinutes": 180,
        "marketDependent": true,
        "allowClosedMarketWhenMaterial": true,
        "requiredSites": ["trendspider"],
        "requiresSidekick": true,
        "estimatedSidekickMessages": 1,
        "sourceMaximums": {"itemCount": 6},
        "requiredSourceFlags": ["officialReleaseVerified", "materialItemsOnly"]
      }
    },
    {
      "id": "options-flow-daily",
      "name": "ChartChamp Options Flow",
      "channel": "options-flow",
      "rrule": "FREQ=WEEKLY;BYDAY=MO,TU,WE,TH,FR;BYHOUR=10;BYMINUTE=0",
      "promptFile": "prompts/options-flow-daily.md",
      "model": "gpt-5.6-terra",
      "reasoningEffort": "high",
      "validation": {
        "freshnessMinutes": 30,
        "marketDependent": true,
        "requiredSites": ["trendspider"],
        "requiresSidekick": true,
        "estimatedSidekickMessages": 1,
        "sourceMaximums": {"bullishCount": 3, "bearishCount": 3},
        "requiredSourceFlags": ["intentUncertaintyLabeled"]
      }
    },
    {
      "id": "insider-trades-weekly",
      "name": "ChartChamp Insider Trades - Weekly",
      "channel": "insider-trades",
      "rrule": "FREQ=WEEKLY;BYDAY=FR;BYHOUR=13;BYMINUTE=45",
      "promptFile": "prompts/insider-trades-weekly.md",
      "model": "gpt-5.6-terra",
      "reasoningEffort": "high",
      "validation": {
        "freshnessMinutes": 180,
        "marketDependent": true,
        "requiredSites": ["trendspider"],
        "requiresSidekick": true,
        "estimatedSidekickMessages": 1,
        "sourceMaximums": {"itemCount": 5},
        "requiredSourceFlags": ["form4sVerified", "sevenDayWindow"]
      }
    }
  ]
}
